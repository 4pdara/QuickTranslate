{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuickTranslate",
  "version": "0.1.2",
  "identifier": "com.quicktranslate.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "QuickTranslate — תרגום מהיר",
        "url": "index.html",
        "width": 540,
        "height": 405,
        "minWidth": 460,
        "minHeight": 350,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
